<% content_for :title, "About Us | PAK Home Appliances" %>

<section class="pak-page-hero">
  <div class="pak-wrap">
    <p class="pak-kicker">About PAK</p>
    <h1 class="pak-display" style="font-size: clamp(36px, 5vw, 56px);">Built on Trust. Designed for Tomorrow.</h1>
    <p class="pak-lede">At Wahid Industries, we design and manufacture appliances that meet the diverse needs of Pakistani homes — efficient, durable, and built to last.</p>
  </div>
</section>

<section class="pak-section">
  <div class="pak-wrap pak-story">
    <div>
      <p class="pak-kicker">Heritage</p>
      <h2>Manufacturing from Gujrat, for the country.</h2>
      <p class="pak-lede">PAK Fan maintains high standards of quality control so every product meets or exceeds regulatory and safety standards. Our work is to provide reliable products that keep up with changing needs.</p>
      <%= link_to "Our vision & mission", vision_path, class: "pak-btn pak-btn-ghost", style: "margin-top: 24px;" %>
    </div>
    <div class="pak-feature-grid" style="grid-template-columns: 1fr 1fr;">
      <article class="pak-feature" style="background: var(--pak-mist); border-color: var(--pak-line);">
        <h3>Quality</h3>
        <p class="pak-muted">Inspection and durability standards across every product family.</p>
      </article>
      <article class="pak-feature" style="background: var(--pak-mist); border-color: var(--pak-line);">
        <h3>Innovation</h3>
        <p class="pak-muted">Better performance, lower energy use, longer life.</p>
      </article>
      <article class="pak-feature" style="background: var(--pak-mist); border-color: var(--pak-line);">
        <h3>Nationwide</h3>
        <p class="pak-muted">A dealer and service network that reaches homes across Pakistan.</p>
      </article>
      <article class="pak-feature" style="background: var(--pak-mist); border-color: var(--pak-line);">
        <h3>Customer trust</h3>
        <p class="pak-muted">Service, feedback, and products that improve with real use.</p>
      </article>
    </div>
  </div>
</section>
