<% content_for :title, "Cart | PAK Home Appliances" %>

<section class="pak-page-hero">
  <div class="pak-wrap">
    <p class="pak-kicker">Cart</p>
    <h1 class="pak-display" style="font-size: clamp(36px, 5vw, 56px);">Your selection</h1>
    <p class="pak-lede">A premium checkout flow will connect to live inventory next. For now, review featured PAK products and continue.</p>
    <div class="pak-hero-actions">
      <%= link_to "Continue shopping", shop_path, class: "pak-btn pak-btn-ghost" %>
      <%= link_to "Checkout", checkout_path, class: "pak-btn pak-btn-primary" %>
    </div>
  </div>
</section>
